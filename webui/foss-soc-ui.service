# systemd unit for the FOSS SOC Engine Web UI.
#
# Install (run from the repo root on the Ubuntu server):
#   sudo cp webui/foss-soc-ui.service /etc/systemd/system/
#   # edit the paths/user/IP below to match your machine, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now foss-soc-ui
#   systemctl status foss-soc-ui          # check it is running
#   journalctl -u foss-soc-ui -f          # watch its logs
#
# Then open  http://<server-ip>:8600  from any machine on the network.

[Unit]
Description=FOSS SOC Engine - Web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# --- EDIT THESE ---
# The Linux user to run as (create a non-root one ideally), and the repo path.
User=soc
WorkingDirectory=/opt/foss-soc-engine

# Listen on all interfaces so the UI is reachable over the network.
Environment=SOC_UI_HOST=0.0.0.0
Environment=SOC_UI_PORT=8600
Environment=SOC_UI_NO_BROWSER=1

# REQUIRED under systemd: without this, Python buffers stdout and the startup
# banner (incl. the [auth] line and the first-run generated password) may not
# appear in `journalctl -u foss-soc-ui` until much later.
Environment=PYTHONUNBUFFERED=1

# --- LOGIN (pick ONE, see "Signing in" in the README) ---
# a) Use your ELK stack's elastic user/password (recommended on ELK servers):
#Environment=SOC_ENV_FILE=/opt/TLSOCDockerDeploy/.env
#    (or set  auth.env_file  in config.yaml instead - same effect)
# b) Your own fixed credentials:
#Environment=SOC_UI_USER=youruser
#Environment=SOC_UI_PASSWORD=yourpassword
# c) Neither set -> a password is GENERATED on first start; read it with:
#    journalctl -u foss-soc-ui | grep password:

# Optional: enable the Start/Stop/Restart engine buttons in the Monitor tab.
#Environment=SOC_UI_ALLOW_CONTROL=1

# Use the private UI virtual-env created by start-soc-ui.sh (recommended), or
# change this to a plain "python3" if you installed Flask/PyYAML system-wide.
ExecStart=/opt/foss-soc-engine/.venv-ui/bin/python /opt/foss-soc-engine/webui/app.py

Restart=on-failure
RestartSec=3

# Light hardening (optional, safe defaults)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
